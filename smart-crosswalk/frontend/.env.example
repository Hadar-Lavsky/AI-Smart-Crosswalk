# ─────────────────────────────────────────────────────────────────
# Frontend API Configuration
# ─────────────────────────────────────────────────────────────────
# Local development - uses Vite proxy (vite.config.js):
VITE_API_URL=/api

# Production (Vercel) - set this to your Render backend URL:
# VITE_API_URL=https://smart-crosswalk-backend.onrender.com/api

# ─────────────────────────────────────────────────────────────────
# Socket.IO URL (optional)
# ─────────────────────────────────────────────────────────────────
# If not set, derived automatically from VITE_API_URL origin.
# Production (Vercel) - set this to your Render backend URL:
# VITE_SOCKET_URL=https://smart-crosswalk-backend.onrender.com

# ─────────────────────────────────────────────────────────────────
# Backend URL for Vite Dev Proxy (local development only)
# ─────────────────────────────────────────────────────────────────
# VITE_BACKEND_URL=http://localhost:3000
# VITE_BACKEND_URL=http://192.168.1.100:3000  (LAN teammate)
