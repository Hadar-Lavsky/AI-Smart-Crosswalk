# ─────────────────────────────────────────────────────────────────
# Frontend API Configuration
# ─────────────────────────────────────────────────────────────────
# API URL for production builds
#
# Local development - uses Vite proxy (vite.config.js):
VITE_API_URL=/api
#
# Production - full backend URL:
# VITE_API_URL=https://api.yourdomain.com/api
#
# Same machine, different port:
# VITE_API_URL=http://localhost:3000/api

# ─────────────────────────────────────────────────────────────────
# Backend URL for Vite Dev Proxy (optional)
# ─────────────────────────────────────────────────────────────────
# Override the proxy target in vite.config.js
# VITE_BACKEND_URL=http://localhost:3000
# VITE_BACKEND_URL=http://192.168.1.100:3000  (LAN teammate)
